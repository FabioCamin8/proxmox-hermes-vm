# Copy this file to config/local.env and fill in deployment-specific values.
# Never commit config/local.env, keys, credentials, or infrastructure identifiers.

PVE_HOST=
VMID=
VM_NAME=hermes-agent
STORAGE=
BRIDGE=vmbr0
VLAN_ID=
MTU=1500

CPU_TYPE=host
CORES=4
MEMORY_MB=6144
DISK_SIZE_GB=64
MACHINE=q35
BIOS=ovmf

CI_USER=hermes
SSH_PUBLIC_KEY_FILE=
IPCONFIG0=ip=dhcp
CIUPGRADE=0

# Use an explicitly selected official Debian 13 genericcloud image.
IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
IMAGE_SHA256_URL=https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS
IMAGE_CACHE_DIR=
START_VM=0
