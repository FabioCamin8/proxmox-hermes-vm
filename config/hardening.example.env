# Copy to a private file and fill in the public key path and firewall scope.
# This file contains no deployment-specific defaults and is safe to keep as a
# template. Never commit a real key or network range.

HERMES_USER=hermes
ADMIN_USER=ops
ADMIN_SSH_PUBLIC_KEY_FILE=

# LLMNR is disabled by default. Set true only when it is required.
ENABLE_LLMNR=false

# Firewall application is deliberately opt-in and requires an explicit range.
ENABLE_FIREWALL=false
SSH_ALLOWED_CIDR=
SSH_ALLOWED_IPV6_CIDR=
FIREWALL_ROLLBACK_SECONDS=120

# Provider and graphical smoke tests are run from the actual Hermes session;
# the root hardening validator does not impersonate that desktop session.
CDP_ADDRESS=127.0.0.1
CDP_PORT=9222
