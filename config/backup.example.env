# Copy to a root-controlled deployment file outside the repository, for example
# /etc/hermes-backup/backup.env. Never commit that deployment file or password.

HERMES_USER=hermes
HERMES_HOME=/home/hermes

# The operator must identify and approve a genuinely off-host restic repository.
# Examples of format only: sftp:user@backup-host:/srv/restic/hermes or
# rclone:approved-remote:restic/hermes. Do not place a real endpoint here.
BACKUP_DESTINATION_KIND=off-host
BACKUP_REPOSITORY=
BACKUP_PASSWORD_FILE=/etc/hermes-backup/restic-password

INCLUDE_CHROMIUM_PROFILE=true
INCLUDE_SESSION_HISTORY=true
INCLUDE_USER_MEMORIES=true

# Retention is disabled by default until the first validated baseline exists.
APPLY_RETENTION=false
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

